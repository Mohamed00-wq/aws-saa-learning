{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "AllowApplicationReadObjects",
            "Effect": "Allow",
            "Action": "s3:GetObject",
            "Resource": "arn:aws:s3:::mybucket/*"
        },
        {
            "Sid": "DecryptWithSpecificKMSKey",
            "Effect":"Allow",
            "Action":"kms:Decrypt",
            "Resource": "arn:aws:kms:us-east-1:000000000000:key/3f15c7b6-73b1-45a9-9ecb-cfd22c05b1a5"
        }
    ]
}