{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DecryptPaymentsDataOnly",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::111122223333:role/PaymentsRole"
      },
      "Action": "kms:Decrypt",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "kms:EncryptionContext:Application": "Payments"
        }
      }
    }
  ]
}